OPENAI_API_KEY=
DATABASE_URL=

# Inside Compose containers: postgresql+asyncpg://cda:cda@db:5432/cda
# From the host (Compose publishes db on CDA_DB_PORT, default 5433 to avoid a local Postgres):
# DATABASE_URL=postgresql+asyncpg://cda:cda@localhost:5433/cda
# CDA_DB_PORT=5433

CDA_UPLOAD_DIR=uploads
CDA_MAX_UPLOAD_MB=50

# Optional Langfuse v2 tracing (all three required; host-side re-export CLI):
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
